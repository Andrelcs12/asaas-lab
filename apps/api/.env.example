NODE_ENV=development
PORT=3001

# Legado local (monorepo) — PORT tem prioridade quando definido
API_PORT=3333
API_URL=http://localhost:3333
WEB_URL=http://localhost:3000

# Opcional para desenvolvimento local completo
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/asaas_payment_lab
JWT_SECRET=replace-with-a-secure-random-value
JWT_EXPIRES_IN=8h
PAYMENT_PROVIDER=asaas
LOG_LEVEL=debug

# Asaas Sandbox
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_AUTH_TOKEN=
ASAAS_WEBHOOK_URL=

# Aliases legados (ainda suportados)
ASAAS_ENVIRONMENT=sandbox
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
