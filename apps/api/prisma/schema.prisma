generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  VIEWER
}

enum CustomerSyncStatus {
  PENDING
  SYNCED
  FAILED
}

enum PaymentOrderType {
  ONE_TIME
  SUBSCRIPTION_INITIAL
  SUBSCRIPTION_RENEWAL
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
}

enum PaymentOrderStatus {
  DRAFT
  PENDING
  CHECKOUT_CREATED
  PROCESSING
  CONFIRMED
  FAILED
  EXPIRED
  CANCELED
}

enum InternalPaymentStatus {
  PENDING
  PROCESSING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  FAILED
  CANCELED
}

enum SubscriptionCycle {
  MONTHLY
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAUSED
  OVERDUE
  CANCELED
  FAILED
}

enum WebhookEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  paymentOrders       PaymentOrder[]
  subscriptions       Subscription[]       @relation("SubscriptionCreator")
  canceledSubscriptions Subscription[]       @relation("SubscriptionCanceler")
  auditLogs           AuditLog[]
}

model Customer {
  id              String             @id @default(uuid())
  name            String
  email           String
  cpfCnpj         String
  phone           String?
  address         String?
  asaasCustomerId String?            @unique
  syncStatus      CustomerSyncStatus @default(PENDING)
  lastSyncError   String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  paymentOrders PaymentOrder[]
  payments      Payment[]
  subscriptions Subscription[]

  @@index([syncStatus])
  @@index([email])
}

model PaymentOrder {
  id                String             @id @default(uuid())
  customerId        String
  createdById       String
  description       String
  type              PaymentOrderType
  method            PaymentMethod
  amount            Decimal            @db.Decimal(10, 2)
  externalReference String             @unique
  idempotencyKey    String?            @unique
  asaasCheckoutId   String?            @unique
  checkoutUrl       String?
  status            PaymentOrderStatus @default(DRAFT)
  dueDate           DateTime
  expiresAt         DateTime?
  failureReason     String?
  internalNote      String?
  subscriptionId    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  customer     Customer      @relation(fields: [customerId], references: [id])
  createdBy    User          @relation(fields: [createdById], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  payments     Payment[]

  @@index([status])
  @@index([customerId])
  @@index([idempotencyKey])
}

model Payment {
  id                String                @id @default(uuid())
  paymentOrderId    String?
  subscriptionId    String?
  customerId        String
  asaasPaymentId    String?               @unique
  externalReference String?
  billingType       PaymentMethod?
  asaasStatus       String?
  internalStatus    InternalPaymentStatus @default(PENDING)
  value             Decimal               @db.Decimal(10, 2)
  netValue          Decimal?              @db.Decimal(10, 2)
  dueDate           DateTime?
  paymentDate       DateTime?
  confirmedDate     DateTime?
  receivedDate      DateTime?
  invoiceUrl        String?
  renewalNumber     Int?
  rawData           Json?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  paymentOrder PaymentOrder? @relation(fields: [paymentOrderId], references: [id])
  subscription Subscription? @relation(fields: [subscriptionId], references: [id])
  customer     Customer      @relation(fields: [customerId], references: [id])

  @@index([internalStatus])
  @@index([customerId])
  @@index([subscriptionId])
  @@index([externalReference])
  @@index([asaasPaymentId])
}

model Subscription {
  id                   String             @id @default(uuid())
  customerId           String
  createdById          String
  description          String
  asaasSubscriptionId  String?            @unique
  externalReference    String             @unique
  cycle                SubscriptionCycle  @default(MONTHLY)
  amount               Decimal            @db.Decimal(10, 2)
  status               SubscriptionStatus @default(PENDING)
  asaasStatus          String?
  nextDueDate          DateTime?
  pausedAt             DateTime?
  resumedAt            DateTime?
  canceledAt           DateTime?
  canceledById         String?
  cancelReason         String?
  rawData              Json?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  customer      Customer       @relation(fields: [customerId], references: [id])
  createdBy     User           @relation("SubscriptionCreator", fields: [createdById], references: [id])
  canceledBy    User?          @relation("SubscriptionCanceler", fields: [canceledById], references: [id])
  payments      Payment[]
  paymentOrders PaymentOrder[]

  @@index([status])
  @@index([customerId])
  @@index([asaasSubscriptionId])
}

model WebhookEvent {
  id           String             @id @default(uuid())
  asaasEventId String             @unique
  eventType    String
  resourceType String?
  resourceId   String?
  payload      Json
  status       WebhookEventStatus @default(PENDING)
  attempts     Int                @default(0)
  lastError    String?
  receivedAt   DateTime           @default(now())
  processedAt  DateTime?
  nextRetryAt  DateTime?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([nextRetryAt])
}

model AuditLog {
  id            String   @id @default(uuid())
  actorId       String?
  action        String
  entityType    String
  entityId      String?
  correlationId String?
  metadata      Json?
  ipAddress     String?
  createdAt     DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId])
  @@index([correlationId])
  @@index([createdAt])
}

model ReconciliationRun {
  id              String   @id @default(uuid())
  status          String   @default("RUNNING")
  paymentsChecked Int      @default(0)
  subscriptionsChecked Int @default(0)
  divergencesFound Int     @default(0)
  divergencesFixed Int     @default(0)
  summary         Json?
  startedAt       DateTime @default(now())
  finishedAt      DateTime?
  createdAt       DateTime @default(now())
}
